{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/turnstyle/clayabm/",
      "destination": "/turnstile/clayabm/",
      "permanent": true
    },
    {
      "source": "/turnstyle/clayabm/:path+",
      "destination": "/turnstile/clayabm/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/artera-share-of-model(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/antithesis-share-of-model(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/ethyca-share-of-model(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ]
}