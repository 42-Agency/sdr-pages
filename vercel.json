{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/turnstyle/clayabm",
      "destination": "/turnstile/clayabm/",
      "permanent": true
    },
    {
      "source": "/turnstyle/clayabm/:path*",
      "destination": "/turnstile/clayabm/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
